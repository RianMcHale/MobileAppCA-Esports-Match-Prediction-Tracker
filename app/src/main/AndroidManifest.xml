<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- allows the app to request pandascore data. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- sets the app icon, name, theme, and backup options. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EsportsPredictionTracker">

        <!-- declares the saved prediction screen. -->
        <activity
            android:name=".predictions.PredictionHistoryActivity"
            android:exported="false"
            android:parentActivityName=".main.MainActivity" />

        <!-- declares the form used to pick a winning team. -->
        <activity
            android:name=".predictions.PredictionActivity"
            android:exported="false"
            android:parentActivityName=".matches.MatchListActivity" />

        <!-- declares the screen that lists cs2 matches. -->
        <activity
            android:name=".matches.MatchListActivity"
            android:exported="false"
            android:parentActivityName=".main.MainActivity" />

        <!-- makes the home screen the app's starting screen. -->
        <activity
            android:name=".main.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>